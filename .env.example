# Google Cloud Text-to-Speech (recommended)
# Enable: Cloud Text-to-Speech API + billing in Google Cloud Console
GOOGLE_TTS_API_KEY=

# Progress sync (Vercel + Neon Postgres) — server-side only, never expose in Vite:
# DATABASE_URL=postgresql://...  (auto-injected on Vercel when Neon is linked)

# Orthographia web app (scripts/orthografia-app/web/.env.example for full list):
# CLERK_SECRET_KEY=
# VITE_CLERK_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY= / STRIPE_PRICE_YEARLY= / STRIPE_PRICE_FAMILY_YEARLY=

# Web app auth & billing (see scripts/orthografia-app/web/.env.example)
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# STRIPE_PRICE_FAMILY_YEARLY=price_...

# Azure Speech (alternative)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
