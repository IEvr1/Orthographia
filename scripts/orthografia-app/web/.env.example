# Copy to .env.local for local development.
# On Vercel: Settings → Environment Variables (or `vercel env pull`).

# Neon Postgres (auto-injected when Neon is linked on Vercel)
DATABASE_URL=postgresql://...

# Clerk — use pk_live_/sk_live_ in Production on Vercel (not pk_test_/sk_test_)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
STRIPE_PRICE_FAMILY_YEARLY=price_...

# Super admin (full access without Stripe)
SUPER_ADMIN_EMAIL=mustrene@gmail.com
VITE_SUPER_ADMIN_EMAIL=mustrene@gmail.com

# Contact form (Resend)
RESEND_API_KEY=re_...
CONTACT_TO=info@nexaipla.com
CONTACT_FROM=onboarding@resend.dev

# Vercel Cron auth for /api/cron/weekly-parent-email
CRON_SECRET=
